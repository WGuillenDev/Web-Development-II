<header class="topbar glass">
  <div class="topbar__inner">
    <a class="brand" href="/">
      <span class="brand__mark"><svg class="icon"><use href="#i-logo"/></svg></span>
      <span class="brand__name">Sky<span class="text-gradient">Social</span></span>
    </a>

    <nav class="nav" aria-label="Módulos">
      <span class="nav__indicator" aria-hidden="true"></span>
      <a class="nav__link" href="#clima" data-module="clima"><svg class="icon"><use href="#i-cloud-sun"/></svg>Clima</a>
      <a class="nav__link is-active" href="#feed" data-module="feed"><svg class="icon"><use href="#i-feed"/></svg>Feed</a>
      <a class="nav__link" href="#chat" data-module="chat"><svg class="icon"><use href="#i-chat"/></svg>Chat</a>
    </nav>

    <div class="topbar__actions">
      <span class="status" data-status="connecting" role="status">
        <span class="status__dot"></span><span class="status__label">Conectando…</span>
      </span>
      <button class="theme-toggle" type="button" aria-label="Cambiar tema">
        <svg class="icon theme-toggle__sun"><use href="#i-sun"/></svg>
        <svg class="icon theme-toggle__moon"><use href="#i-moon"/></svg>
      </button>
    </div>
  </div>
</header>
