{
  "name": "skysocial",
  "version": "1.0.0",
  "description": "Red social en tiempo real con clima local, feed y chat global",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch --preserveWatchOutput",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
